# TeleDDNS Configuration File
#
# Copy this file to /etc/teleddns/teleddns.yaml and edit the values below.
# For more information, see: https://github.com/tmshlvck/teleddns
#
# TeleDDNS is designed to work with teleddns-server:
# https://github.com/tmshlvck/teleddns-server
#
# The server provides a REST API endpoint for DDNS updates. You need to set up
# the server first and obtain credentials (username/password) to configure
# this client.

---
# Enable debug logging (set to true for troubleshooting)
debug: false

# DDNS server URL with authentication credentials
# Format: https://USERNAME:PASSWORD@your-ddns-server.example.com/ddns/update
# Replace:
#   - USERNAME: Your DDNS account username from teleddns-server
#   - PASSWORD: Your DDNS account password from teleddns-server
#   - your-ddns-server.example.com: Hostname of your teleddns-server instance
ddns_url: 'https://USERNAME:PASSWORD@your-ddns-server.example.com/ddns/update'

# The fully qualified domain name (FQDN) that will be updated
# This hostname must be configured in your teleddns-server
hostname: 'myhost.ddns.example.com'

# Enable IPv6 address updates (recommended for most setups)
enable_ipv6: true

# Enable IPv4 address updates
enable_ipv4: false

# Network interfaces to monitor for address changes
# Use '*' to monitor all interfaces, or specify interface names:
# interfaces:
#   - 'eth0'
#   - 'wlan0'
interfaces:
  - '*'

# Optional: Hooks to run after address changes
# Hooks can be used to update firewall rules or run custom scripts
# Example:
# hooks:
#   - nft_sets_outfile: "/etc/nftables.d/00-localnets.rules"
#     shell: "nft -f /etc/nftables.conf"

# ---------------------------------------------------------------------------
# Update timing. Every key below is optional; the defaults shown are what the
# client uses when the key is absent, and they are chosen to stay inside what
# teleddns-server permits (60 updates per hour and address family). Durations are
# written as human-readable strings: '5s', '2min', '15min', '12h'.
# ---------------------------------------------------------------------------

# How long to wait for the address set to stop changing before publishing. Longer
# means a link bounce or a DHCP renew collapses into a single update.
# ddns_settle_delay: '5s'

# Hard minimum between two updates of the same family. The server sustains one per
# minute; going below this only earns 'abuse' responses.
# ddns_min_interval: '60s'

# Sliding-window cap per family. Half of the server's 60/hour, so that a flapping
# address hits our own governor instead of the server's rate limit.
# ddns_max_updates_per_hour: 30

# Retry pacing after a failed update: the first retry waits ddns_retry_min, then
# doubles up to ddns_retry_max. A rate-limited answer ('abuse', HTTP 429) waits at
# least ddns_retry_ratelimit_min, because the server counts a one-hour window.
# ddns_retry_min: '60s'
# ddns_retry_max: '1h'
# ddns_retry_ratelimit_min: '15min'

# Re-publish unconditionally this often, even when nothing changed: insurance
# against a record lost or changed on the server. Set to '0s' to disable.
# ddns_resync_period: '12h'

# Re-read the whole address set from the kernel this often. Off by default —
# netlink notifications are reliable. Set a duration to enable.
# ddns_kernel_poll_period: '0s'

# Timeout for a single DDNS request.
# http_timeout: '30s'
