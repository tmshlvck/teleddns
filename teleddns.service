[Unit]
Description=TeleDDNS - Advanced DDNS Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/teleddns
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
# /var/lib/teleddns holds the addresses the server last acknowledged, so that a
# restart (or a restart loop) does not re-publish an unchanged address and spend
# the server's hourly update budget.
StateDirectory=teleddns
# The daemon shuts down on SIGTERM; give it a moment to finish an update in flight.
KillSignal=SIGTERM
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
