[Unit]
Description=TeleDDNS - Advanced DDNS Client
After=network-online.target
Wants=network-online.target
# Give up rather than restart forever. Each start publishes the current address,
# so an endless crash loop would spend the server's hourly update budget.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/teleddns
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
# The daemon shuts down on SIGTERM; give it a moment to finish an update in flight.
KillSignal=SIGTERM
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
